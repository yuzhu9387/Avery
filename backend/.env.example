# Template for backend/.env — copy this file to `.env` and fill in the values.
# `.env` itself is gitignored; this example is the only committed record of
# which keys exist. OAuth setup walkthrough: Avery/docs/OAUTH_SETUP.md

# --- Core (defaults shown; only set to override) ---
DATABASE_URL=sqlite+aiosqlite:///data/avery.db
ENABLE_SCHEDULER=true
WEEK_ROLL_HOUR=20

# --- OAuth sign-in + calendar connections (empty = feature shows "not configured") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LARK_APP_ID=
LARK_APP_SECRET=

# Frontend origin; the provider-facing redirect_uri is derived from it as
# {base}/api/auth/oauth/{provider}/callback — register exactly that at Google/Lark.
OAUTH_REDIRECT_BASE=http://localhost:5173
